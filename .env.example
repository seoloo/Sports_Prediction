# 로컬 데이터 플랫폼 설정 예시. 실제 값은 `python -m pipelines.config init-env`가 .env에 무작위로 만든다.
# .env는 Git에 올리지 않는다.
POSTGRES_USER=sports
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sports
POSTGRES_PORT=55432
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
# 이 PC에서 쓰는 포트는 49152 아래로 둔다. Windows(Hyper-V)가 재부팅 때 그 위 구간을 예약해 포트 연결이 막힐 수 있다(2026-10-23, 59000·59092가 막힘).
S3_PORT=45900
BRONZE_BUCKET=bronze
LAKE_BUCKET=lake
KAFKA_PORT=45992
# football-data.org API 키(https://www.football-data.org/client/register에서 직접 발급). 공개 저장소에 올리지 않는다.
FOOTBALL_DATA_ORG_API_KEY=
# 텔레그램 알림(선택). @BotFather에서 만든 봇 토큰과 내 대화방 ID. 공개 저장소에 올리지 않는다.
# 대화방 ID는 봇에게 아무 메시지나 보낸 뒤 python -m pipelines.notify.telegram chat-id 로 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The Odds API 키(선택, https://the-odds-api.com 무료 Starter). 다가올 경기의 해외 배당을 자동으로 받는다.
THE_ODDS_API_KEY=
# balldontlie 키(선택, https://www.balldontlie.io 무료 가입). NBA 경기 일정·결과를 자동으로 받는다(분당 5회).
BALLDONTLIE_API_KEY=
